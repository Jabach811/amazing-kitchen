{
  "name": "amazing-kitchen-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "stage": "node scripts/stage-static.mjs",
    "dev": "npm run stage && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run stage && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "test": "npm run stage && node --test tests/static-site.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-rsc": "0.5.26",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
